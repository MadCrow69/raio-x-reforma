# Ponto de entrada único: SPA + proxy para os motores oficiais (rede interna).
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	# Segurança: só recursos da própria origem (a SPA não usa script/estilo inline nem CDN; fontes e CSS são
	# servidos de /assets; o download do CSV usa blob:), sem moldura de outro site, sem farejar tipo, sem Referer.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# /motor/regular/api/... -> motor-regular:8080/api/... (prefixo removido)
	handle /motor/* {
		request_body {
			max_size 2MiB
		}

		handle_path /motor/regular/* {
			reverse_proxy motor-regular:8080
		}
		handle_path /motor/simples/* {
			reverse_proxy motor-simples:8082
		}
		respond 404
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
